<%# A video from a provider of RenderPolicy, loaded only when the visitor opens it. The page runs no script: the player is an iframe with loading="lazy" inside a closed details, which Chromium does not request until the details opens (tools/probes/lazy-iframe-in-details.ts). The picture on the closed card is the theme's, drawn in CSS: nothing is asked of the provider before the click. The card says "the provider", as the approved design does, and never a provider's name. -%>
<%- props = block_props(block) -%>
<%- src = RenderPolicy.video_src(props["provider"], props["videoId"]) -%>
<%- title = prop_text(props, "title") -%>
<%= tag.div(**block_root(block, [ "w", "w-video", BlockStyle.visibility_classes(block_style(block)) ], data: { provider: (props["provider"] if RenderPolicy.video_provider?(props["provider"])) })) do %><% if src %><%= tag.details(class: "sw-embed sw-video") do %><%= tag.summary(class: "sw-embed-load") do %><%= tag.span(tag.span(theme_svg("play", css_class: "sw-play-icon"), class: "sw-play-dot"), class: "sw-embed-media sw-video-poster") %><%= tag.span(safe_join([ tag.strong(title), tag.small("Loads a video from the provider when you click.", class: "sw-when-closed"), tag.small("Playing from the provider. Click here to close it.", class: "sw-when-open") ]), class: "sw-embed-bar") %><% end %><%= tag.div(tag.iframe(src: src, title: title, loading: "lazy", allow: "fullscreen; picture-in-picture; encrypted-media", allowfullscreen: true, referrerpolicy: "strict-origin-when-cross-origin"), class: "sw-embed-frame sw-embed-frame-video") %><% end %><% end %><% end %>
