<%# A quotation, in the Heading 3 step unless the style names another, with who said it when the block says. -%>
<%- props = block_props(block) -%>
<%- style = block_style(block) -%>
<%= tag.div(**block_root(block, [ "w", "w-quote", BlockStyle.classes(style, "textSize", default: "heading-3"), %w[typeface color align].map { |key| BlockStyle.classes(style, key) }, BlockStyle.visibility_classes(style) ], data: { **BlockStyle.free_color_data(style, "color"), **BlockStyle.free_type_data(style) })) do %><%= tag.figure(class: "sw-quote") do %><%= theme_svg("quote", css_class: "sw-quote-mark") %><%= tag.blockquote(tag.p(text_with_breaks(prop_text(props, "text")))) %><%= tag.figcaption(props["attribution"]) if props["attribution"].is_a?(String) %><% end %><% end %>
