<%# Rich text: paragraphs, line breaks, lists, bold, italic and links (RichTextHelper). -%>
<%- style = block_style(block) -%>
<%= tag.div(**block_root(block, [ "w", "w-text", %w[textSize color align].map { |key| BlockStyle.classes(style, key) }, BlockStyle.visibility_classes(style) ])) do %><%= rich_text(block_props(block)["doc"]) %><% end %>
