<%# One column of a section: its widgets, top to bottom. -%>
<%- style = block_style(block) -%>
<%= tag.div(**block_root(block, [ "col", %w[background spaceInside spaceBetween textSize color align verticalAlign].map { |key| BlockStyle.classes(style, key) }, BlockStyle.visibility_classes(style) ])) do %><%= render_blocks(block["children"], allow: BlocksHelper::WIDGET_TYPES, media: media) %><% end %>
