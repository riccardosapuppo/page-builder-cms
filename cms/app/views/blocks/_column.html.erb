<%# One column of a section: its widgets, top to bottom. -%>
<%- style = block_style(block) -%>
<%= tag.div(**block_root(block, [ "col", %w[background spaceInside spaceBetween textSize color align verticalAlign].map { |key| BlockStyle.classes(style, key) }, BlockStyle.visibility_classes(style) ], data: { **BlockStyle.free_color_data(style, "background"), **BlockStyle.free_color_data(style, "color") })) do %><%= render_blocks(block["children"], allow: BlocksHelper::WIDGET_TYPES, media: media, cached: local_assigns[:cached], answers: local_assigns[:answers]) %><% end %>
