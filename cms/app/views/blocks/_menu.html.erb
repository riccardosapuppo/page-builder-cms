<%# The site's links in a row, and Menu, which opens them as a sheet where the block is narrower than the row needs: data-fold names the step of site.css's container queries below which the row folds, worked out from the widths of the labels' letters (HeaderFit). A link whose address RenderPolicy refuses is left out, as is an item that is not a link; with no link left there is no Menu to open. The menu's name is for a screen reader, Menu when it has none. -%>
<%- props = block_props(block) -%>
<%- style = block_style(block) -%>
<%- links = menu_links(props["items"]) -%>
<%- label = prop_text(props, "label") -%>
<%= tag.div(**block_root(block, [ "w", "w-menu", %w[color align].map { |key| BlockStyle.classes(style, key) }, BlockStyle.visibility_classes(style) ], data: { fold: HeaderFit.menu_fold(links.map(&:first)) })) do %><%= tag.nav(aria: { label: label.empty? ? "Menu" : label }) do %><%= tag.div(safe_join(links.map { |text, href| tag.a(text, href: href) }), class: "w-menu-links") %><% if links.any? %><%= tag.details(safe_join([ tag.summary(safe_join([ theme_svg("menu", css_class: "sw-menu-icon"), tag.span("Menu", class: "w-menu-word") ]), class: "sw-menu-button"), tag.div(safe_join(links.map { |text, href| tag.a(text, href: href) }), class: "sw-menu-sheet") ]), class: "w-menu-fold") %><% end %><% end %><% end %>
