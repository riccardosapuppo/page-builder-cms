<%# A band across the page: its columns side by side on desktop, stacked below. The column count is the number of children, and columnWidths the share of each on desktop (widths-*, tokens.css), equal when the section names no preset for that count; spaceBetween is the gap between the columns; spaceAbove and spaceBelow the space above and below them, or the theme's rhythm for the device when the style names none. -%>
<%- style = block_style(block) -%>
<%- columns = Array(block["children"]).select { |child| child.is_a?(Hash) && child["type"] == "column" } -%>
<%- widths = BlockStyle.column_widths(block_props(block), columns.size) -%>
<%= tag.section(**block_root(block, [ "sec", BlockStyle.classes(style, "background"), BlockStyle.classes(style, "spaceAbove"), BlockStyle.classes(style, "spaceBelow"), BlockStyle.visibility_classes(style) ], id: RenderPolicy.anchor(block_props(block)["anchor"]), data: { columns: columns.size, column_widths: widths })) do %><%= tag.div(class: [ "sw-inner", "cols", "cols-#{columns.size.clamp(1, 4)}", ("widths-#{SiteTheme::TokenCss.class_value(widths)}" if widths), BlockStyle.classes(style, "spaceBetween", family: "cols-gap") ]) do %><%= render_blocks(columns, allow: %w[column], media: media, cached: local_assigns[:cached], answers: local_assigns[:answers]) %><% end %><% end %>
