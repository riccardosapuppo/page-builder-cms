<%#
  The layout of every page a visitor sees: published pages, the 404 page,
  the draft preview, and what a sent form is answered with (a confirmation,
  a refusal, or the page drawn again above the list of what to put right,
  @form_errors). No csrf_meta_tags and no csp_meta_tag: either
  would read the session, and a session writes a cookie onto a page meant
  to be cached and shared. No script either; the Content-Security-Policy
  (PublicPage) says script-src 'none'. The header and footer are the
  site's (Site: what the editor set, or config/site.yml's defaults), the
  same on every page. With no links there is no Menu to open; links too
  long for the bar fold into it on wider pages too, below the width
  data-fold names (HeaderFit). The main
  content's id has an underscore, which a section anchor cannot hold (the
  schema's ^[a-z][a-z0-9-]{0,63}$), so no anchor can take the skip link's
  target.
-%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= @title %></title>
<%= tag.meta(name: "description", content: @description) if @description.present? %>
<%= tag.meta(name: "robots", content: "noindex") if @noindex %>
<%= tag.link(rel: "icon", href: image_path("site-mark.svg"), type: "image/svg+xml") %>
<%= preload_link_tag("archivo-variable.woff2") %>
<%= preload_link_tag("source-serif-4-variable.woff2") %>
<%= stylesheet_link_tag("site", "tokens") %>
</head>
<body>
<%= tag.div(class: "site", data: site_style_data(site_style)) do %><div class="sw">
<a class="sw-skip" href="#main_content">Skip to content</a>
<%- links = site_links(site.menu) -%>
<header <%= tag.attributes(class: "sw-header", data: { fold: HeaderFit.fold(site) }) %>><div class="sw-inner sw-header-row"><a class="sw-brand" href="/"><%= theme_svg("mark", css_class: "sw-brand-mark") %><span><%= site.name %></span></a><nav class="sw-nav" aria-label="Main"><div class="sw-nav-links"><%= safe_join(links) %></div><%= site_link(site.action, class: "sw-btn sw-btn-small") %><% if links.any? %><details class="sw-menu"><summary class="sw-menu-button"><%= theme_svg("menu", css_class: "sw-menu-icon") %>Menu</summary><div class="sw-menu-sheet"><%= safe_join(links) %></div></details><% end %></nav></div></header>
<main id="main_content">
<%= render("pages/form_errors", errors: @form_errors) if @form_errors -%>
<%= yield %>
</main>
<footer class="sw-footer"><div class="sw-inner sw-footer-row"><%= theme_svg("mark", css_class: "sw-brand-mark sw-brand-mark-inv") %><p><strong><%= site.footer["lead"] %></strong> <%= site.footer["text"] %></p></div></footer>
</div><% end %>
</body>
</html>
