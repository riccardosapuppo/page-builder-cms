{
  "name": "page-builder-cms-builder",
  "version": "0.1.0",
  "private": true,
  "description": "The page editor of Page Builder CMS: React and TypeScript, built with Vite, saving to the Rails CMS through its JSON API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "lint": "oxlint -f default --deny-warnings src e2e build test vite.config.ts",
    "lint:plants": "vitest run --project unit build/lint-fence.test.ts",
    "test": "vitest run --project unit",
    "test:rails": "vitest run --project rails",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/geometry": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@dnd-kit/state": "0.5.0",
    "@rails/activestorage": "8.1.400",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/static-renderer": "3.31.3",
    "ajv": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.2",
    "jsdom": "29.1.1",
    "oxlint": "1.86.0",
    "parse5": "8.0.1",
    "playwright-core": "1.62.1",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
