    { "name": "no object", "settings": [ true ], "faults": [ [ "", "type", "must be a JSON object" ] ] },
    { "name": "every member missing", "settings": {}, "faults": [
      [ "/enabled", "required", "is required" ], [ "/currency", "required", "is required" ],
      [ "/productsCollectionId", "required", "is required" ], [ "/priceField", "required", "is required" ]
    ] },
    { "name": "a member the settings do not take, before the rest", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": null, "priceField": null, "taxes": true, "a/b~c": 1 }, "faults": [
      [ "/taxes", "additionalProperties", "is not a member this request takes" ], [ "/a~1b~0c", "additionalProperties", "is not a member this request takes" ]
    ] },
    { "name": "on, as a word", "settings": { "enabled": "yes", "currency": "GBP", "productsCollectionId": 1, "priceField": "price" }, "faults": [ [ "/enabled", "type", "must be true or false" ] ] },
    { "name": "a currency not of the list", "settings": { "enabled": false, "currency": "JPY", "productsCollectionId": null, "priceField": null }, "faults": [ [ "/currency", "enum", "must be one of GBP, EUR, USD" ] ] },
    { "name": "a currency in lower case", "settings": { "enabled": false, "currency": "gbp", "productsCollectionId": null, "priceField": null }, "faults": [ [ "/currency", "enum", "must be one of GBP, EUR, USD" ] ] },
    { "name": "a currency as its number", "settings": { "enabled": false, "currency": 826, "productsCollectionId": null, "priceField": null }, "faults": [ [ "/currency", "enum", "must be one of GBP, EUR, USD" ] ] },
    { "name": "a collection's id as text", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": "1", "priceField": null }, "faults": [ [ "/productsCollectionId", "type", "must be a collection's id, or null" ] ] },
    { "name": "a collection's id of zero", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 0, "priceField": null }, "faults": [ [ "/productsCollectionId", "type", "must be a collection's id, or null" ] ] },
    { "name": "a collection's id with a fraction", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 1.5, "priceField": null }, "faults": [ [ "/productsCollectionId", "type", "must be a collection's id, or null" ] ] },
    { "name": "a collection's id past the integers a number holds", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 9007199254740993, "priceField": null }, "faults": [ [ "/productsCollectionId", "type", "must be a collection's id, or null" ] ] },
    { "name": "a collection the site does not have", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 99, "priceField": "price" }, "faults": [ [ "/productsCollectionId", "collectionExists", "The site has no collection 99." ] ] },
    { "name": "a collection with no number field, whose price is then not looked for", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 2, "priceField": "summary" }, "faults": [ [ "/productsCollectionId", "numberField", "The collection News has no number field to be the price." ] ] },
    { "name": "a price field that is no number field", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 1, "priceField": "summary" }, "faults": [ [ "/priceField", "priceField", "The collection Products has no number field \"summary\"." ] ] },
    { "name": "a price field the collection does not have", "settings": { "enabled": true, "currency": "GBP", "productsCollectionId": 1, "priceField": "cost" }, "faults": [ [ "/priceField", "priceField", "The collection Products has no number field \"cost\"." ] ] },
    { "name": "a price field holding U+0000", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 1, "priceField": "pri\u0000ce" }, "faults": [ [ "/priceField", "priceField", "The collection Products has no number field \"pri\u0000ce\"." ] ] },
    { "name": "a price field with no collection to take it from", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": null, "priceField": "price" }, "faults": [ [ "/priceField", "priceField", "Choose the products collection first." ] ] },
    { "name": "a price field that is no text", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 1, "priceField": 3 }, "faults": [ [ "/priceField", "type", "must be a field's key, or null" ] ] },
    { "name": "on with neither a collection nor a price", "settings": { "enabled": true, "currency": "GBP", "productsCollectionId": null, "priceField": null }, "faults": [
      [ "/productsCollectionId", "required", "is required for a shop that is on" ], [ "/priceField", "required", "is required for a shop that is on" ]
    ] },
    { "name": "on with a collection and no price", "settings": { "enabled": true, "currency": "GBP", "productsCollectionId": 3, "priceField": null }, "faults": [ [ "/priceField", "required", "is required for a shop that is on" ] ] },
    { "name": "every member at fault at once", "settings": { "enabled": 1, "currency": "XYZ", "productsCollectionId": 99, "priceField": 5 }, "faults": [
      [ "/enabled", "type", "must be true or false" ], [ "/currency", "enum", "must be one of GBP, EUR, USD" ],
      [ "/productsCollectionId", "collectionExists", "The site has no collection 99." ], [ "/priceField", "type", "must be a field's key, or null" ]
    ] }
  ],
