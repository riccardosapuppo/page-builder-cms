{
  "about": "The shop's rules, written twice and read the same way by the editor and the browser's storage (builder/src/shared/shop.ts) and by the CMS (cms/app/models/shop_rules.rb): the shop's settings and the faults both must find in them, at their pointers, with their keywords and words; a price as the smallest unit of its currency, and an amount in the site's words; a cart as it is kept, a change of it, a cart once an order made from it is paid, and a cart priced from what its products published. See contract/README.md.",
  "collections": [
    { "id": 1, "name": "Products", "fields": [ { "key": "summary", "type": "paragraph" }, { "key": "price", "type": "number" }, { "key": "in-stock", "type": "toggle" } ] },
    { "id": 2, "name": "News", "fields": [ { "key": "summary", "type": "paragraph" }, { "key": "day", "type": "date" } ] },
    { "id": 3, "name": "Events", "fields": [ { "key": "places", "type": "number" }, { "key": "fee", "type": "number" } ] }
  ],
  "settings": [
    { "name": "off, as a new site has it", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": null, "priceField": null }, "faults": [] },
    { "name": "on, selling the products by their price", "settings": { "enabled": true, "currency": "EUR", "productsCollectionId": 1, "priceField": "price" }, "faults": [] },
    { "name": "off, a collection and its price kept for later", "settings": { "enabled": false, "currency": "USD", "productsCollectionId": 3, "priceField": "fee" }, "faults": [] },
    { "name": "off, a collection chosen and no price yet", "settings": { "enabled": false, "currency": "GBP", "productsCollectionId": 3, "priceField": null }, "faults": [] },
