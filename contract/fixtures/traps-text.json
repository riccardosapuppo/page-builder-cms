              "style": { "base": {} }
            },
            {
              "id": "t-accordion", "type": "accordion", "children": [],
              "props": {
                "items": [
                  { "question": "Is </summary><script>alert(1)</script> safe?", "answer": "Yes: it is text.\nOn two lines & escaped." },
                  { "question": "Second, closed", "answer": "Closed until opened." }
                ]
              },
              "style": { "base": {} }
            },
            {
              "id": "t-stats", "type": "stats", "children": [],
