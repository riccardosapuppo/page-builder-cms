              "style": { "base": {} }
            },
            {
              "id": "t-heading-link", "type": "heading", "children": [],
              "props": { "level": 2, "text": "A heading that links", "href": "/winter?a=1&c='3'#join" },
              "style": { "base": {} }
            },
            {
              "id": "t-heading-link-with-quote", "type": "heading", "children": [],
