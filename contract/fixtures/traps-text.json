              "style": { "base": {} }
            },
            {
              "id": "t-heading-javascript", "type": "heading", "children": [],
              "props": { "level": 3, "text": "A heading whose link runs script", "href": "javascript:alert(document.cookie)" },
              "style": { "base": {} }
            },
            {
              "id": "t-heading-level-out-of-range", "type": "heading", "children": [],
              "props": { "level": 7, "text": "Level 7 does not exist" },
              "style": { "base": {} }
            },
            {
              "id": "t-text", "type": "text", "children": [],
              "props": {
                "doc": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        { "type": "text", "text": "Plain <script>alert(1)</script> & more: " },
                        { "type": "text", "text": "bold", "marks": [ { "type": "bold" } ] },
                        { "type": "text", "text": ", " },
                        { "type": "text", "text": "both", "marks": [ { "type": "bold" }, { "type": "italic" } ] },
                        { "type": "text", "text": ", a " },
                        { "type": "text", "text": "safe link", "marks": [ { "type": "link", "attrs": { "href": "https://example.com/?a=1&b='2'", "target": "_blank", "rel": "noopener noreferrer nofollow", "class": null } } ] },
                        { "type": "hardBreak" },
                        { "type": "text", "text": "and links that must not survive: " },
                        { "type": "text", "text": "javascript", "marks": [ { "type": "link", "attrs": { "href": "javascript:alert(1)" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "mixed case", "marks": [ { "type": "link", "attrs": { "href": " JaVaScRiPt:alert(2)" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "tab", "marks": [ { "type": "link", "attrs": { "href": "java\tscript:alert(3)" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "entity", "marks": [ { "type": "link", "attrs": { "href": "javascript&colon;alert(4)" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "data", "marks": [ { "type": "link", "attrs": { "href": "data:text/html,<script>alert(5)</script>" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "another site", "marks": [ { "type": "link", "attrs": { "href": "//evil.example/" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "backslash", "marks": [ { "type": "link", "attrs": { "href": "/\\evil.example" } } ] }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        { "type": "text", "text": "Unicode: caffè, naïve, é combining, 日本語, emoji 🎉 👩‍👩‍👧, RTL שלום, a no-break space, literal &amp; entity, &copy text,   three spaces." }
                      ]
                    },
                    { "type": "paragraph" },
                    {
                      "type": "bulletList",
                      "content": [
                        { "type": "listItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "first <li>" } ] } ] },
                        {
                          "type": "listItem",
                          "content": [
                            { "type": "paragraph", "content": [ { "type": "text", "text": "second, with a nested list" } ] },
                            {
                              "type": "orderedList", "attrs": { "start": 3, "type": null },
                              "content": [
                                { "type": "listItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "three" } ] } ] },
                                { "type": "listItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "four", "marks": [ { "type": "italic" } ] } ] } ] }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "orderedList", "attrs": { "start": 1, "type": "i" },
                      "content": [
                        { "type": "listItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "roman one" } ] } ] }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        { "type": "text", "text": "an unknown mark is dropped", "marks": [ { "type": "underline" } ] },
                        { "type": "image", "attrs": { "src": "https://evil.example/x.png" } }
                      ]
                    },
                    { "type": "heading", "attrs": { "level": 1 }, "content": [ { "type": "text", "text": "an unknown node is dropped" } ] }
                  ]
                }
              },
              "style": { "base": {} }
            },
            {
              "id": "t-button-safe", "type": "button", "children": [],
