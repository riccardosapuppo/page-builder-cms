                        { "type": "hardBreak" },
                        { "type": "text", "text": "and links that must not survive: " },
                        { "type": "text", "text": "javascript", "marks": [ { "type": "link", "attrs": { "href": "javascript:alert(1)" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "mixed case", "marks": [ { "type": "link", "attrs": { "href": " JaVaScRiPt:alert(2)" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "tab", "marks": [ { "type": "link", "attrs": { "href": "java\tscript:alert(3)" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "entity", "marks": [ { "type": "link", "attrs": { "href": "javascript&colon;alert(4)" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "data", "marks": [ { "type": "link", "attrs": { "href": "data:text/html,<script>alert(5)</script>" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "another site", "marks": [ { "type": "link", "attrs": { "href": "//evil.example/" } } ] },
                        { "type": "text", "text": " " },
                        { "type": "text", "text": "backslash", "marks": [ { "type": "link", "attrs": { "href": "/\\evil.example" } } ] }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        { "type": "text", "text": "Unicode: caffè, naïve, é combining, 日本語, emoji 🎉 👩‍👩‍👧, RTL שלום, a no-break space, literal &amp; entity, &copy text,   three spaces." }
                      ]
                    },
                    { "type": "paragraph" },
                    {
                      "type": "bulletList",
