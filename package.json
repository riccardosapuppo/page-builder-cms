{
  "name": "page-builder-cms",
  "version": "0.1.0",
  "private": true,
  "description": "A page builder and CMS: Rails 8 stores, versions, caches and publishes the pages; a React and TypeScript editor builds them.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node tools/start.cjs",
    "setup": "node tools/start.cjs --setup",
    "typecheck": "tsc -p tsconfig.json",
    "lint:openapi": "node tools/lint-openapi.ts",
    "probe:lazy-iframe": "node tools/probes/lazy-iframe-in-details.ts",
    "seed:images": "node tools/seed-images.ts",
    "contract:large": "node tools/gen-contract-500.ts",
    "shots:site": "node tools/site-shots.ts",
    "check:type-scales": "node tools/type-scales.ts",
    "check:production": "node tools/check-production.ts",
    "test:tools": "node --test \"tools/**/*.test.ts\"",
    "builder:install": "npm ci --prefix builder",
    "builder:typecheck": "npm run typecheck --prefix builder",
    "builder:lint": "npm run lint --prefix builder",
    "builder:test": "npm run test --prefix builder",
    "builder:build": "npm run build --prefix builder",
    "builder:test:rails": "npm run test:rails --prefix builder",
    "builder:e2e": "npm run e2e --prefix builder"
  },
  "devDependencies": {
    "@redocly/cli": "2.57.0",
    "@types/node": "24.19.0",
    "@types/semver": "7.8.0",
    "playwright": "1.62.1",
    "semver": "7.8.5",
    "typescript": "6.0.3"
  }
}
