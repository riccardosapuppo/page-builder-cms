  "aspect": {
    "$description": "The crops an image may take, width to height, as the value of CSS aspect-ratio; original keeps the image's own shape. The approved page crops its hero image square on desktop, 16:9 on tablets and 5:4 on phones, and its gallery and quote images 4:3 (design/theme.css); 3:2 completes the common photographic shapes. A block names a crop by its key (the schema's aspectToken), with tablet and phone overrides.",
    "site": {
      "original": "auto",
      "16:9": "16 / 9",
      "3:2": "3 / 2",
      "4:3": "4 / 3",
      "5:4": "5 / 4",
      "1:1": "1 / 1"
    }
  },
