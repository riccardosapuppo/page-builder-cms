  "site-tones": {
    "$description": "The six palette slots of Site style, from the approved mock (the site-style state of design/index.html and its token sheet). A block names a slot, the schema's paletteSlot, never a tone. The site owner gives each slot one of its tones, from this list only, and every block that uses the slot follows. A tone is a colour of the color list above; default is the tone a new site starts with.",
    "text": {
      "label": "Text",
      "default": "site-ink",
      "tones": [
        { "color": "site-ink", "label": "Ink" }
      ]
    },
    "background": {
      "label": "Background",
      "default": "site-paper",
      "tones": [
        { "color": "site-paper", "label": "Paper" }
      ]
    },
    "primary": {
      "label": "Primary",
      "default": "site-sea",
      "tones": [
        { "color": "site-sea", "label": "Sea" },
        { "color": "site-harbour", "label": "Harbour" },
        { "color": "site-kelp", "label": "Kelp" },
        { "color": "site-basalt", "label": "Basalt" }
      ]
    },
    "accent": {
      "label": "Accent",
      "default": "site-buoy",
      "tones": [
        { "color": "site-buoy", "label": "Buoy" },
        { "color": "site-cap-pink", "label": "Cap pink" },
        { "color": "site-sea-glass", "label": "Sea glass" },
        { "color": "site-lemon", "label": "Lemon" }
      ]
    },
    "soft": {
      "label": "Soft",
      "default": "site-shallows",
      "tones": [
        { "color": "site-shallows", "label": "Shallows" }
      ]
    },
    "muted": {
      "label": "Muted",
      "default": "site-slate",
      "tones": [
        { "color": "site-slate", "label": "Slate" }
      ]
    }
  },
  "site-type-scale": {
    "$description": "The contrast between the steps of the site type scale, the other choice of Site style. Balanced is the scale drawn in type.site; the mock names Gentle and Strong but does not draw their sizes yet.",
    "default": "balanced",
    "choices": [
      { "name": "gentle", "label": "Gentle" },
      { "name": "balanced", "label": "Balanced" },
      { "name": "strong", "label": "Strong" }
    ]
  },
