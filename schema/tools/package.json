{
  "name": "page-builder-cms-schema-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Checks for the page document schema: application rules, corpus, and the comparison of the two validators.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compare": "node compare.ts",
    "compare:examples": "node compare-examples.ts",
    "corpus": "node gen-corpus.ts",
    "corpus:check": "node gen-corpus.ts --check",
    "lint": "node lint.ts",
    "lint:plants": "node lint-plants.ts",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
