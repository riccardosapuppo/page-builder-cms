  "entries": [
    {
      "title": "Swim cap",
      "slug": "swim-cap",
      "values": {
        "summary": "A bright silicone cap in orange, pink or white, so the boat and the shore can count every head.",
        "image": {
          "mediaId": "g-caps",
          "alt": "Three swim caps, orange, pink and white, at the waterline"
        },
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "We count heads by their caps. On grey water in the half light of a dawn swim, an orange or a pink one shows from the shore; a black or a navy one does not."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The cap is plain silicone, with no name on it, and fits most heads. Say which colour you want when you pick it up at the hut."
                }
              ]
            }
          ]
        },
        "price": 12,
        "in-stock": true
      }
    },
    {
      "title": "Tow float",
      "slug": "tow-float",
      "values": {
        "summary": "An orange float on a waist belt, trailing behind you as you swim, with a dry pocket for your keys.",
        "image": {
          "mediaId": "mark-1-shallows",
          "alt": "A small orange float with a red pennant, in shallow water off the slipway"
        },
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A tow float makes you easy to see from the shore, and gives you something to hold if you want a rest on the way out."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "It sits behind you on a short line and does not slow you down. Blow it up at the slipway, and let the air out once you are dry."
                }
              ]
            }
          ]
        },
        "price": 24,
        "in-stock": true
      }
    },
    {
      "title": "Enamel mug",
      "slug": "enamel-mug",
      "values": {
        "summary": "White enamel with a dark rim: the mug the hut pours the tea into after every swim.",
        "image": {
          "mediaId": "m-tea",
          "alt": "A red flask and two enamel mugs of tea on a rock after a swim"
        },
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Enamel keeps the tea hot while your hands warm up, and it does not mind being dropped on the rocks."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Write your name on the bottom and leave it on the hooks in the hut, or take it home with you."
                }
              ]
            }
          ]
        },
        "price": 9.5,
        "in-stock": false
      }
    },
    {
      "title": "Winter series pass",
      "slug": "winter-series-pass",
      "values": {
        "summary": "Five Sundays of the winter series, whichever five suit you between November and March.",
        "image": {
          "mediaId": "m-winter",
          "alt": "The jetty in winter, the safe-water mark beyond it"
        },
        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A Sunday of the winter series is £6 on the day. The pass gives you five of them for £25."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Come on the Sundays that suit you, and give your name at the slipway each time: we tick it off."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The swims keep to the winter rules. They are short, they stay close to the shore, and the tea after is very hot."
                }
              ]
            }
          ]
        },
        "price": 25,
        "in-stock": true
      }
    }
  ],
