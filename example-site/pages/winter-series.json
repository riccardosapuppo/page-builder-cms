                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The sea is at its clearest in winter, and at its coldest. We keep swims short and stay close to the shore."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "What to bring:",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "bulletList",
                      "content": [
